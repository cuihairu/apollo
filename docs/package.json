{
  "name": "apollo-docs",
  "version": "1.0.0",
  "description": "Apollo 技术文档",
  "scripts": {
    "docs:dev": "vitepress dev . --host 0.0.0.0 --port 8080",
    "docs:build": "vitepress build .",
    "docs:preview": "vitepress preview . --host 0.0.0.0 --port 8080",
    "docs:clean": "node -e \"const fs=require('fs');fs.rmSync('.vitepress/dist',{recursive:true,force:true});fs.rmSync('.vitepress/cache',{recursive:true,force:true});\""
  },
  "keywords": [
    "apollo",
    "lightweight-mmo",
    "tower-defense",
    "game-server",
    "documentation"
  ],
  "author": "Apollo Team",
  "license": "MIT",
  "devDependencies": {
    "mermaid": "^11.16.1",
    "vue": "^3.5.30",
    "vitepress": "^1.6.4"
  }
}
