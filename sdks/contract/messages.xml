<?xml version="1.0" encoding="UTF-8"?>
<!-- messages.xml — 消息/意图契约。dir=C2S 为 intent only（服务端定夺，docs/05 §6.4）。
     domain：内外分域必填（sdk-contract §11.3，client 1-899 / internal 900+ 分段）；
     binding：缺省按通道（movement/attributes/control=native，events=reflect，
     sdk-contract §10.6 v3）——本批四条全为框架固定消息族，走缺省 native。 -->
<messages version="2">
  <msg id="10" name="move" dir="C2S" channel="movement" domain="client" desc="移动意图">
    <field name="x" type="float"/>
    <field name="y" type="float"/>
    <field name="z" type="float"/>
    <field name="yaw" type="float"/>
  </msg>
  <msg id="11" name="attr_batch" dir="S2C" channel="attributes" domain="client" desc="属性批量差分（含快照，attribute-sync §10）">
    <field name="seq" type="int32" desc="本连接已确认水位"/>
    <field name="base_seq" type="int32" desc="快照基线水位"/>
    <field name="deltas" type="bytes" desc="差分负载（AttrDelta 编码，随 attribute-sync §7 定型）"/>
  </msg>
  <msg id="12" name="error" dir="S2C" channel="control" domain="client" desc="错误下发">
    <field name="code" type="int32" desc="errors.xml 错误码"/>
    <field name="message" type="string"/>
  </msg>
  <msg id="13" name="heartbeat" dir="C2S" channel="control" domain="client" desc="心跳">
    <field name="client_ms" type="timestamp" desc="客户端毫秒时钟"/>
  </msg>
  <msg id="14" name="scene_transfer" dir="C2S" channel="control" domain="client" desc="换幕意图（P1-1；服务端定夺——准入/驳回见 scene_transfer_result）">
    <field name="target_scene_id" type="int64" desc="目标 scene 号"/>
    <field name="x" type="float" desc="请求落点（易失态不带走，服务端权威可改）"/>
    <field name="y" type="float"/>
    <field name="z" type="float"/>
  </msg>
  <msg id="15" name="scene_transfer_result" dir="S2C" channel="control" domain="client" desc="换幕结果（含驳回码，scene_transfer 面唯一下行）">
    <field name="code" type="int32" desc="0=成功；非 0 为驳回/失败原因（errors.xml 随批扩充）"/>
    <field name="target_scene_id" type="int64" desc="目标 scene 号（成功=新场景，失败=原样回显）"/>
  </msg>

  <!-- 登录族（login-flow §8 client 域新增；实现侧 modules/protocol 0x0001/0x0002
       欠账入库，P1-6 收尾批「契约不含此域」三字段之一在此消账）。
       过载拒绝码 busy+retry_after、排队 QueueNotice 归 P3（login-flow §8）；
       LoginHello/LoginAuth 分步握手为设计稿演进面，实现未落地不入库。 -->
  <msg id="16" name="login_request" dir="C2S" channel="control" domain="client" desc="登录请求（login-app 鉴权）">
    <field name="username" type="string"/>
    <field name="password" type="string" desc="鉴权明文面随登录连接 CryptoFilter 槽位（net §5.5），契约层不加密"/>
    <field name="client_version" type="string"/>
    <field name="timestamp" type="int64" desc="客户端毫秒时钟"/>
  </msg>
  <msg id="17" name="login_response" dir="S2C" channel="control" domain="client" desc="登录应答（含网关落点与准入票据）">
    <field name="success" type="bool"/>
    <field name="session_id" type="int64" desc="连接域会话号"/>
    <field name="player_id" type="int64" desc="玩家身份（强分型 id 值域）"/>
    <field name="gateway_host" type="string"/>
    <field name="gateway_port" type="int32"/>
    <field name="login_ticket" type="string" desc="客户端凭此向 gateway 换取准入（P1-6 欠账字段入库）"/>
    <field name="error_message" type="string"/>
  </msg>

  <!-- 在线目录事件族（P1-2，session-and-online-directory §8：internal 域 900+；
       单进程阶段为进程内事件面行为契约，跨进程镜像/总线留 P3） -->
  <msg id="900" name="session_up" dir="P2P" channel="events" domain="internal" desc="会话登记（Zone→manager；准入通过+Zone 接受后上报）">
    <field name="player_id" type="int64" desc="玩家身份（强分型 id 值域）"/>
    <field name="entity_id" type="int64" desc="实体号（ServerID 分段，RouteResolver 先验分流）"/>
    <field name="session_id" type="int64" desc="连接域会话号"/>
    <field name="gateway_id" type="int32" desc="接入网关"/>
    <field name="zone_id" type="int32" desc="宿主 Zone"/>
    <field name="anchor_epoch" type="int64" desc="同账号第 N 次会话（幂等+竞争裁决键）"/>
    <field name="world_id" type="int32" desc="落点四件套"/>
    <field name="map_id" type="int64"/>
    <field name="instance_id" type="int64"/>
    <field name="space_id" type="int64"/>
    <field name="route_version" type="int64"/>
  </msg>
  <msg id="901" name="session_down" dir="P2P" channel="events" domain="internal" desc="会话消亡（Zone→manager；登出/窗口满终结）">
    <field name="player_id" type="int64"/>
    <field name="anchor_epoch" type="int64" desc="旧 epoch 迟到事件按失效丢弃（§2 幂等）"/>
    <field name="reason" type="int32" desc="1=登出 2=窗口满（框架保留段）"/>
  </msg>
  <msg id="902" name="session_moved" dir="P2P" channel="events" domain="internal" desc="落点迁移（Zone→manager；换幕/换 Zone handoff）">
    <field name="player_id" type="int64"/>
    <field name="anchor_epoch" type="int64"/>
    <field name="world_id" type="int32"/>
    <field name="map_id" type="int64"/>
    <field name="instance_id" type="int64"/>
    <field name="space_id" type="int64"/>
    <field name="route_version" type="int64"/>
  </msg>
  <msg id="903" name="session_kicked" dir="P2P" channel="events" domain="internal" desc="顶号踢除（manager→旧 Zone；销毁会话实体或转托管由业务定）">
    <field name="player_id" type="int64"/>
    <field name="old_anchor_epoch" type="int64" desc="被顶条目 epoch（epoch 失效即拒，§3-③）"/>
    <field name="reason" type="int32" desc="3=顶号（新顶旧）"/>
  </msg>
  <msg id="904" name="directory_snapshot_request" dir="P2P" channel="events" domain="internal" desc="对账请求（manager→Zone；30s 周期，失配走全量对表）">
    <field name="nonce" type="int64" desc="对账轮次号"/>
  </msg>
  <msg id="905" name="directory_snapshot_reply" dir="P2P" channel="events" domain="internal" desc="对账应答（Zone→manager；全量在线集）">
    <field name="nonce" type="int64" desc="回显轮次号"/>
    <field name="player_ids" type="int64[]" desc="该 Zone 全量在线集"/>
  </msg>

  <!-- 重连/保活窗口事件族（P1-6，lifecycle §2.4：internal 域 900+；
       断线挂机窗口 + resume_token 同源 TTL；「纯文本 disconnect」消灭） -->
  <msg id="906" name="gateway_client_disconnect" dir="P2P" channel="events" domain="internal" desc="客户端断线（gateway→Zone；替代历史纯文本断线通知）">
    <field name="session_id" type="int64" desc="连接域会话号"/>
    <field name="player_id" type="int64"/>
    <field name="normal_close" type="int32" desc="1=正常退出 0=异常掉线"/>
  </msg>
  <msg id="907" name="session_resume_request" dir="P2P" channel="events" domain="internal" desc="重连恢复请求（gateway→Zone；窗口内 token 校验通过即恢复）">
    <field name="session_id" type="int64"/>
    <field name="player_id" type="int64"/>
    <field name="resume_token" type="int64" desc="挂机时下发，TTL=窗口时长（同源）"/>
  </msg>
  <msg id="908" name="session_resume_reply" dir="P2P" channel="events" domain="internal" desc="重连恢复应答（Zone→gateway；拒绝即走完整重登，Avatar 重建）">
    <field name="session_id" type="int64"/>
    <field name="player_id" type="int64"/>
    <field name="accepted" type="int32" desc="1=恢复 0=拒绝（token 死/窗口满/会话已终结）"/>
  </msg>

  <!-- 网关指派族（P1-6 收尾批欠账入库：loginTicket/errorMessage 三字段所在消息
       面补齐；实现侧 modules/protocol 0x0010/0x0011）。
       gateway_client_connect（0x0013）为 legacy 既有非 P0-P1 新增，不入库。 -->
  <msg id="909" name="gateway_assign_request" dir="P2P" channel="events" domain="internal" desc="网关指派请求（gateway→login-app 随 RPC 上送）">
    <field name="player_id" type="int64"/>
    <field name="session_id" type="int64"/>
    <field name="login_ticket" type="string" desc="准入校验票据（login_response 下发的 ticket 原样上送核销）"/>
  </msg>
  <msg id="910" name="gateway_assign_response" dir="P2P" channel="events" domain="internal" desc="网关指派应答（login-app→gateway）">
    <field name="success" type="bool"/>
    <field name="gateway_host" type="string"/>
    <field name="gateway_port" type="int32"/>
    <field name="token" type="string" desc="gateway 会话令牌"/>
    <field name="error_message" type="string" desc="P1-6 欠账字段入库"/>
  </msg>

  <!-- 玩家生命周期族（P1-2 目录链路 + §34 baseapp/baseappmgr 拆分新增，
       实现侧 modules/protocol 0x0060-0x0067 八消息入库；Anchor 六态的进程间
       驱动面：activate 激活→bind_session 绑定→assign_world 落点→resolve_route
       路由解析。目录权威表在 baseappmgr（§34 裁决），WorldAssignment 经此族
       传递，不跨进程改 anchor 内存） -->
  <msg id="911" name="player_activate_request" dir="P2P" channel="events" domain="internal" desc="玩家激活请求（base-app 装载 Anchor）">
    <field name="player_id" type="int64"/>
  </msg>
  <msg id="912" name="player_activate_response" dir="P2P" channel="events" domain="internal" desc="玩家激活应答（AnchorState 回带）">
    <field name="success" type="bool"/>
    <field name="player_id" type="int64"/>
    <field name="state" type="string" desc="AnchorState 字符串（六态可观察）"/>
    <field name="error_message" type="string"/>
  </msg>
  <msg id="913" name="player_bind_session_request" dir="P2P" channel="events" domain="internal" desc="会话绑定请求（SessionBinding 写入）">
    <field name="player_id" type="int64"/>
    <field name="session_id" type="int64"/>
    <field name="gateway_id" type="int32"/>
    <field name="gateway_addr" type="string"/>
  </msg>
  <msg id="914" name="player_bind_session_response" dir="P2P" channel="events" domain="internal" desc="会话绑定应答">
    <field name="success" type="bool"/>
    <field name="error_message" type="string"/>
  </msg>
  <msg id="915" name="player_assign_world_request" dir="P2P" channel="events" domain="internal" desc="落点指派请求（WorldAssignment 写入，baseappmgr 目录表）">
    <field name="player_id" type="int64"/>
    <field name="world_id" type="int32"/>
    <field name="map_id" type="int64"/>
    <field name="instance_id" type="int64"/>
    <field name="space_id" type="int64"/>
    <field name="route_version" type="int64"/>
  </msg>
  <msg id="916" name="player_assign_world_response" dir="P2P" channel="events" domain="internal" desc="落点指派应答">
    <field name="success" type="bool"/>
    <field name="route_version" type="int64" desc="指派后路由版本"/>
    <field name="error_message" type="string"/>
  </msg>
  <msg id="917" name="player_resolve_route_request" dir="P2P" channel="events" domain="internal" desc="路由解析请求（player_id 为 0 时按 session_id 反查）">
    <field name="player_id" type="int64"/>
    <field name="session_id" type="int64"/>
  </msg>
  <msg id="918" name="player_resolve_route_response" dir="P2P" channel="events" domain="internal" desc="路由解析应答（落点四件套+网关定位全量回带）">
    <field name="success" type="bool"/>
    <field name="player_id" type="int64"/>
    <field name="session_id" type="int64"/>
    <field name="gateway_id" type="int32"/>
    <field name="gateway_addr" type="string"/>
    <field name="world_id" type="int32"/>
    <field name="map_id" type="int64"/>
    <field name="instance_id" type="int64"/>
    <field name="space_id" type="int64"/>
    <field name="route_version" type="int64"/>
    <field name="error_message" type="string"/>
  </msg>
</messages>
