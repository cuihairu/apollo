{
  "name": "apollo-mmorpg",
  "version": "0.1.0",
  "description": "A high-performance, modular MMORPG server development framework",
  "homepage": "https://github.com/cuihairu/apollo",
  "license": "MIT",
  "dependencies": [
    {
      "name": "nlohmann-json",
      "version>=": "3.11.0"
    },
    {
      "name": "protobuf",
      "version>=": "3.21.0"
    },
    {
      "name": "gtest",
      "version>=": "1.12.0"
    },
    {
      "name": "redis-plus-plus",
      "version>=": "1.3.0"
    },
    {
      "name": "fmt",
      "version>=": "9.0.0"
    },
    {
      "name": "spdlog",
      "version>=": "1.12.0"
    },
    {
      "name": "boost-asio",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-system",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-filesystem",
      "version>=": "1.82.0"
    },
    {
      "name": "boost-thread",
      "version>=": "1.82.0"
    }
  ],
  "features": {
    "tests": {
      "description": "Build with test dependencies",
      "dependencies": [
        {
          "name": "gtest",
          "features": ["gmock"]
        }
      ]
    },
    "redis": {
      "description": "Redis client support",
      "dependencies": [
        "redis-plus-plus"
      ]
    },
    "protobuf": {
      "description": "Protocol Buffers support",
      "dependencies": [
        {
          "name": "protobuf",
          "features": ["zlib"]
        }
      ]
    }
  },
  "builtin-baseline": "4c930f26d346a88c879c137a5e6414855fc5bd8e"
}